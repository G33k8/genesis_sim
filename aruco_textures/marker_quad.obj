# Simple quad mesh with UV coordinates for ArUco marker textures
# 1x1 unit plane centered at origin, facing +Z
# Will be rotated/scaled by Genesis morph parameters

# Vertices
v -0.5 -0.5 0.0
v  0.5 -0.5 0.0
v  0.5  0.5 0.0
v -0.5  0.5 0.0

# Texture coordinates (UV)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normal (facing +Z)
vn 0.0 0.0 1.0

# Face (with vertex/texcoord/normal indices)
f 1/1/1 2/2/1 3/3/1 4/4/1

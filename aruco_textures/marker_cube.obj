# Unit cube mesh with UV coordinates mapped on all 6 faces
# Vertices
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# Texture coordinates (UV)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

# Faces (each face uses the same UV mapping from vt 1 to 4)
# Bottom face (-Z)
f 1/1/1 4/2/1 3/3/1 2/4/1
# Top face (+Z)
f 5/1/2 6/2/2 7/3/2 8/4/2
# Front face (-Y)
f 1/1/5 2/2/5 6/3/5 5/4/5
# Back face (+Y)
f 3/1/6 4/2/6 8/3/6 7/4/6
# Left face (-X)
f 4/1/3 1/2/3 5/3/3 8/4/3
# Right face (+X)
f 2/1/4 3/2/4 7/3/4 6/4/4
